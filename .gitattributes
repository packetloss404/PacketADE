# Normalize all text files to LF in the repo and on checkout, so tools that
# rewrite files with CRLF (Windows editors, some CLIs) no longer produce
# whole-file line-ending diff noise. Binary files are auto-detected and left
# untouched. Repo was converged to LF via `git add --renormalize .`.
* text=auto eol=lf

# Windows batch scripts require CRLF (none exist today; rule is future-proofing)
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated human-readable reports are binary artifacts. Do not pass them
# through Windows' system-level `astextplain` diff driver.
*.pdf -text -diff
